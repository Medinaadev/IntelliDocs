# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intellidocs"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="cambia-esto-por-un-string-largo-y-aleatorio"

# URLs
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Almacenamiento — MinIO en local, Cloudflare R2 en producción
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="intellidocs"
S3_REGION="us-east-1"

# Email — si se deja vacío, los emails fallan en silencio y la app sigue funcionando
RESEND_API_KEY=""

# Google OAuth — opcional en local
# Crear credenciales en https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — opcional en local
# Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
STRIPE_PRODUCT_PRO=""
STRIPE_PRODUCT_ENTERPRISE=""

# Entorno
NODE_ENV="development"
